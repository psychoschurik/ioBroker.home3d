{
  "name": "iobroker.3d-home",
  "version": "0.4.0",
  "description": "Local 3D home visualization and floor plan editor for ioBroker",
  "main": "build/main.js",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsx scripts/build.mts",
    "build:frontend": "tsx scripts/build-frontend.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.frontend.json && tsc -p tsconfig.tools.json",
    "check": "npm run typecheck",
    "test": "tsx --test test/*.test.ts",
    "start:demo": "tsx scripts/demo.ts",
    "demo:house": "tsx scripts/create-demo-house.ts",
    "demo:preview": "tsx scripts/preview-house.ts",
    "vendor": "npm run build:frontend",
    "prepack": "npm run check && npm run build:all",
    "test:package": "npm pack && tsx scripts/verify-package.mts",
    "build:all": "npm run build:frontend && npm run build"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.3.2"
  },
  "files": [
    "build/",
    "lib/upstream.json",
    "www/",
    "admin/",
    "io-package.json",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "lit": "^3.3.3",
    "prettier": "^3.10.1",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "author": "ioBroker.3d-home contributors",
  "keywords": [
    "ioBroker",
    "3d-home",
    "visualization",
    "floorplan",
    "smart-home"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psychoschurik/ioBroker.3d-home.git"
  },
  "bugs": {
    "url": "https://github.com/psychoschurik/ioBroker.3d-home/issues"
  },
  "homepage": "https://github.com/psychoschurik/ioBroker.3d-home#readme"
}
