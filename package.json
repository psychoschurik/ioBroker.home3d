{
  "name": "iobroker.3d-home",
  "version": "0.4.0",
  "description": "3D floor plan editor and live visualization for ioBroker, served by the web adapter",
  "author": "ioBroker.3d-home contributors",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "3d-home",
    "visualization",
    "floorplan",
    "smart-home",
    "web"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psychoschurik/ioBroker.3d-home.git"
  },
  "bugs": {
    "url": "https://github.com/psychoschurik/ioBroker.3d-home/issues"
  },
  "homepage": "https://github.com/psychoschurik/ioBroker.3d-home#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "www/",
    "admin/",
    "io-package.json",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsx tasks.ts",
    "build-vendor": "tsx tasks.ts --vendor",
    "build-bridge": "tsx tasks.ts --bridge",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.tasks.json",
    "lint": "eslint -c eslint.config.mjs",
    "test": "npm run test:unit && npm run test:package",
    "test:unit": "tsx --test test/*.test.ts",
    "test:package": "mocha test/packageFiles.js --exit",
    "test:integration": "tsx --test test/*.test.ts",
    "test:pack": "npm pack && tsx scripts/verify-package.mts",
    "demo": "tsx scripts/demo.ts",
    "demo:house": "tsx scripts/create-demo-house.ts",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx npm-check-updates --upgrade"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/socket-client": "^5.6.1",
    "@iobroker/testing": "^5.3.0",
    "@iobroker/types": "^7.2.5",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "lit": "^3.3.3",
    "mocha": "^12.0.3",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
