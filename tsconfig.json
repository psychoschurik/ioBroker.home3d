{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "useUnknownInCatchVariables": false,
    "noEmitOnError": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "src",
    "outDir": "build",
    "types": ["node"],
    "sourceMap": true,
    "inlineSources": true
  },
  "include": ["src/**/*.ts"]
}
