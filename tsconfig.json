// Type check of the browser code in frontend/. It is bundled by Vite (vite.config.ts), tsc only checks.
{
    "compilerOptions": {
        "target": "es2022",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "useUnknownInCatchVariables": false,
        "noEmit": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "types": ["@iobroker/types"]
    },
    "include": ["frontend/**/*.ts", "frontend/**/*.tsx"],
    "exclude": ["node_modules/**", "www/**", "vendor-src/**", "frontend/public/**"]
}
