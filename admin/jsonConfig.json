{
  "type": "panel",
  "items": {
    "intro": {
      "type": "staticText",
      "text": "3D Home: Oberfläche unter http://IOBROKER-IP:PORT öffnen (Standardport 8097). Dort Datenpunkte zuordnen und den Grundriss zeichnen. Ein Zugangsschlüssel mit mindestens 16 Zeichen ist erforderlich. Danach die Instanz aktivieren."
    },
    "bind": {
      "type": "ip",
      "label": "Bind address",
      "listenOnAllPorts": true
    },
    "port": {
      "type": "number",
      "label": "Port",
      "min": 1024,
      "max": 65535
    },
    "accessToken": {
      "type": "password",
      "label": "Zugangsschlüssel (mindestens 16 Zeichen)",
      "visible": true
    },
    "language": {
      "type": "select",
      "label": "Language",
      "options": [
        {
          "label": "Deutsch",
          "value": "de"
        },
        {
          "label": "English",
          "value": "en"
        }
      ]
    }
  }
}
